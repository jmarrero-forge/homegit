#!/usr/bin/env node
// Planning by capacity: this week's usage and burn rate, the projection at
// the reset, and the open P0/P1 estimates by bucket. See --help. Node's
// standard library only, plus bot-cost and bot-board (and python3, where
// the coordinator runs on several backends; see lib/backends.js).
"use strict";

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const cap = require(path.join(__dirname, "..", "lib", "capacity.js"));
const backends = require(path.join(__dirname, "..", "lib", "backends.js"));

const PROG = path.basename(process.argv[1] || "bot-capacity");
const COST = process.env.BOT_CAPACITY_COST || path.join(__dirname, "bot-cost");
const BOARD = process.env.BOT_CAPACITY_BOARD || path.join(__dirname, "bot-board");
// What `bot-heartbeat statusline` saves of Claude Code's rate_limits.
const RATE_FILE = process.env.BOT_CAPACITY_RATE_FILE
  || path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache"), "bot-heartbeat", "rate-limits.json");
const BUDGET_ENV = "BOT_CAPACITY_WEEKLY_TOKENS";
// A reading older than this is not trusted: the status line runs after
// every assistant message, so an older one means it stopped running.
const RATE_MAX_AGE_MS = 3600e3;
const MAX_BUFFER = 256 * 1024 * 1024;
const EX_USAGE = 2;

function usage() {
  return `Usage: ${PROG} [--budget TOKENS] [--json]

Shows the week's capacity: usage and burn rate, the projected percent at
the reset, and the open (Todo, In Progress) P0 and P1 items' Est. cost
buckets summed, with what may be dispatched: all, P0 only above
${cap.P0_ONLY_PERCENT}% projected, nothing at 100%.

The percent is the seven_day.used_percentage that \`bot-heartbeat
statusline\` saves (${RATE_FILE.replace(os.homedir(), "~")}), if it is under an hour old and
its window hasn't reset. Otherwise, with --budget (fresh tokens per week;
or \$${BUDGET_ENV}), it is the trailing 7 days' fresh tokens (input, output
and cache writes) of Claude Code's sessions (bot-cost --source claude)
over the budget. With neither there are
only token totals. Estimates become percent at this week's percent per
token; a bucket counts as ${cap.BUCKETS.map((b) => `${b.key} ${b.expected / 1e3}k`).join(", ")} tokens.

Where the coordinator runs on several backends, handing off from one to
the next at a usage threshold (bot-coordinator-loop's state in
${backends.STATE_FILE.replace(os.homedir(), "~")}), it measures the active backend
instead: its reading (Claude's 7-day window, Copilot's monthly premium
requests) if under an hour old, over that reading's window, and the
tokens of that backend's own sessions (bot-cost --source). While a next
backend is available, all work may be dispatched that fits before the
handoff at the active one's threshold (leave_at); on the last available
one, P0 only from ${cap.P0_ONLY_PERCENT}% projected and nothing at its threshold. An active
backend at its threshold gets nothing new.
`;
}

const run = (cmd, args) => execFileSync(cmd, args, { encoding: "utf8", maxBuffer: MAX_BUFFER, stdio: ["ignore", "pipe", "inherit"] });

// readRate(now): {usedPercent, resetsAt (ms)} of the saved seven_day
// window, or null if missing, stale, malformed or already reset.
function readRate(now) {
  let saved;
  try {
    saved = JSON.parse(fs.readFileSync(RATE_FILE, "utf8"));
  } catch {
    return null;
  }
  const w = saved && saved.seven_day;
  const observed = Date.parse(saved && saved.observed_at);
  const resets = w && Date.parse(w.resets_at);
  if (!w || typeof w.used_percent !== "number" || !(resets > now) || !(now - observed < RATE_MAX_AGE_MS)) return null;
  return { usedPercent: w.used_percent, resetsAt: resets };
}

const pct = (n) => (n === null || n === undefined ? "?" : `${n.toFixed(1)}%`);
const tok = (n) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : `${Math.round(n / 1e3)}k`);

// What the report's percent comes from.
function sourceText(r) {
  if (r.backend) {
    if (r.source === "backend") return `${r.backend.name}'s usage reading`;
    const why = `no reading for ${r.backend.name}: ${r.no_reading || "?"}`;
    return r.source === "budget" ? `tokens over the budget; ${why}` : `tokens only; ${why}, and no budget`;
  }
  return { statusline: "plan usage (statusline)", budget: "tokens over the budget", tokens: "tokens only (no statusline reading, no budget)" }[r.source];
}

function dispatchText(r) {
  const d = r.dispatch;
  if (!r.backend) {
    return { all: "P0 and P1", p0: `P0 only (projected at or above ${cap.P0_ONLY_PERCENT}%)`, none: "nothing (the week's capacity is used up)",
      unknown: "unknown (no percent: pass --budget or run bot-heartbeat statusline)" }[d.scope];
  }
  const scope = { all: "P0 and P1", p0: `P0 only (projected at or above ${Math.min(cap.P0_ONLY_PERCENT, r.backend.leave_at)}%)`, none: "nothing new",
    unknown: `unknown (no percent for ${r.backend.name}: pass --budget)` }[d.scope];
  return `${scope}; ${d.reason}`;
}

function render(r) {
  const out = [];
  if (r.backends) {
    const each = r.backends.map((b) => {
      const reading = b.used_percent === null ? `no reading (${b.no_reading})` : `${pct(b.used_percent)} used`;
      const tags = [b.active && "active", b.name === r.backend.next && "next", !b.available && `unavailable: ${b.why || "not probed yet"}`].filter(Boolean);
      return `${b.name}${tags.length ? ` (${tags.join(", ")})` : ""} ${reading}, leaves at ${b.leave_at}%`;
    });
    out.push(`Backends: ${each.join("; ")}`);
    if (r.config_error) out.push(`  (thresholds are bot-coordinator-loop's defaults: ${r.config_error})`);
  }
  out.push(`${r.backend ? "Window" : "Week"} (${sourceText(r)}): ${tok(r.used_tokens)} fresh tokens${r.used_percent === null ? "" : `, ${pct(r.used_percent)} used`}`);
  if (r.burn_per_day !== null) out.push(`Burn: ${pct(r.burn_per_day)}/day, ${tok(r.burn_tokens_per_day)} tokens/day`);
  else out.push(`Burn: ${tok(r.burn_tokens_per_day)} tokens/day (trailing 7 days)`);
  if (r.resets_at) {
    out.push(`Resets ${r.resets_at}; projected at reset: ${r.projected === null ? `too early in the ${r.backend ? "window" : "week"} to say` : pct(r.projected)}`);
  } else if (r.projected !== null) out.push(`Projected (rolling week): ${pct(r.projected)}`);
  out.push("", "Open P0/P1 (Todo, In Progress) by Est. cost:");
  const rows = [["", ...cap.BUCKETS.map((b) => b.key), "none", "tokens", "percent", "fits"]];
  for (const prio of cap.PLANNED_PRIORITIES) {
    const e = r.estimates[prio];
    rows.push([prio, ...cap.BUCKETS.map((b) => e[b.key].count), e.unestimated, tok(e.tokens), pct(e.percent),
      e.fits === null ? "?" : e.fits ? "yes" : "no"]);
  }
  const w = rows[0].map((_, i) => Math.max(...rows.map((x) => String(x[i]).length)));
  for (const x of rows) out.push("  " + x.map((c, i) => (i ? String(c).padStart(w[i]) : String(c).padEnd(w[i]))).join("  "));
  const headroom = r.backend && r.backend.next ? "headroom before the handoff" : "headroom after projection";
  out.push("", `Dispatch: ${dispatchText(r)}${r.dispatch.headroom === null ? "" : `; ${headroom} ${pct(r.dispatch.headroom)}`}`);
  return `${out.join("\n")}\n`;
}

function main(argv) {
  let budget = Number(process.env[BUDGET_ENV]) || null, json = false;
  for (let i = 0; i < argv.length; i++) {
    switch (argv[i]) {
      case "-h": case "--help": process.stdout.write(usage()); return 0;
      case "--json": json = true; break;
      case "--budget":
        budget = Number(argv[++i]);
        if (!(budget > 0)) { process.stderr.write(`${PROG}: --budget takes a number of tokens\n`); return EX_USAGE; }
        break;
      default: process.stderr.write(`${PROG}: unexpected argument '${argv[i]}'\n\n${usage()}`); return EX_USAGE;
    }
  }
  const now = process.env.BOT_CAPACITY_NOW ? Date.parse(process.env.BOT_CAPACITY_NOW) : Date.now();
  let view = null;
  try {
    view = backends.backendView(now);
  } catch (e) {
    process.stderr.write(`${PROG}: ignoring the coordinator's backends: ${e.message}\n`);
  }
  const active = view && view.backends.find((b) => b.active);
  let rate, costArgs = [];
  if (active) {
    rate = active.reading && active.window
      ? { usedPercent: active.reading.used_percent, resetsAt: active.window.end, startsAt: active.window.start } : null;
    if (active.source) costArgs = ["--source", active.source];
  } else {
    // The statusline's percent is the Claude plan's, so only Claude
    // Code's tokens count: bot-cost counts opencode's too, wherever its
    // database is.
    rate = readRate(now);
    if (rate) rate.startsAt = rate.resetsAt - cap.WEEK_MS;
    costArgs = ["--source", "claude"];
  }
  const since = new Date(rate ? rate.startsAt : now - cap.WEEK_MS).toISOString();
  const weekTokens = JSON.parse(run(COST, ["--since", since, "--no-compute", "--tasks", "0", ...costArgs, "--json"])).totals.fresh_tokens;
  const items = JSON.parse(run(BOARD, ["list", "--json"]));
  const backend = active && { name: active.name, leave_at: active.leave_at, available: active.available, why: active.why, next: view.next };
  const report = cap.capacityReport({ rate, weekTokens, budget, items, now, backend });
  if (active) {
    report.no_reading = rate ? null : active.no_reading || (active.reading ? "its probe's window isn't known" : null);
    report.config_error = view.config_error;
    report.backends = view.backends.map((b) => ({
      name: b.name, active: b.active, available: b.available, why: b.why, leave_at: b.leave_at,
      used_percent: b.reading ? b.reading.used_percent : null, no_reading: b.no_reading,
    }));
  }
  process.stdout.write(json ? `${JSON.stringify(report, null, 2)}\n` : render(report));
  return 0;
}

if (require.main === module) process.exit(main(process.argv.slice(2)));
else module.exports = { readRate, render };
